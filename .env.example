# Estas variables las genera Vercel automáticamente al conectar una base
# "Postgres" (Neon) desde el tab Storage de tu proyecto en vercel.com.
# Cópialas a .env.local para desarrollar en local, o usa `vercel env pull`.

POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Llaves VAPID para Web Push. Genéralas una sola vez con: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY debe estar expuesta al navegador (por eso el prefijo NEXT_PUBLIC_).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
